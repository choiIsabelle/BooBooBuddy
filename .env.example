# BooBoo Buddy Environment Variables
# Copy this file to .env and fill in your values

# Database URL (using SQLite for local development)
DATABASE_URL="file:./dev.db"

# OpenAI API Key (required for real LLM responses, mock mode if not provided)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# OpenAI Model (optional, defaults to gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"

# Google Places API Key (for clinic search functionality)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# NEXT_PUBLIC_ prefix is needed for client-side access in Next.js
GOOGLE_PLACES_API_KEY=""
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=""
